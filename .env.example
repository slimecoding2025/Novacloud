# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=change-me-db
NOVACLOUD_SECRET_KEY=change-me-at-least-32-random-characters
RUNNER_TOKEN=change-me-long-random-token
METRICS_TOKEN=change-me-metrics-token
GRAFANA_ADMIN_PASSWORD=change-me-grafana
NOVACLOUD_ENV=development
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Host group id of /var/run/docker.sock (run: stat -c %g /var/run/docker.sock)
# Optional reverse proxy (docker compose --profile proxy up -d proxy), see deploy/proxy/Caddyfile
#PROXY_SITE=http://:8081
#PROXY_UPSTREAM=127.0.0.1:20080
DOCKER_GID=999

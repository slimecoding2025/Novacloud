{
  "title": "NOVACLOUD overview",
  "uid": "novacloud-overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {"id": 1, "type": "stat", "title": "Database up (live ping)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "novacloud_database_up", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Metric sources available", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "targets": [{"expr": "sum(novacloud_metric_available)", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "HTTP requests / s by status", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (status) (rate(novacloud_http_requests_total[1m]))", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "Jobs by status", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "targets": [{"expr": "novacloud_jobs", "legendFormat": "{{status}}", "refId": "A"}]}
  ]
}
